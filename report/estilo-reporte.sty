% =====================================================================
% estilo-reporte.sty -- elementos de forma do relatorio de andamento
%
% BASE. Fonte, pacotes, numeros e unidades, legenda, titulo de secao e
% cabecalho saem de `config/preambulo.tex`, o mesmo arquivo que os
% documentos de `docs/product/` carregam. Esta folha acrescenta so o que
% e do relatorio: paleta, abertura com a marca, titulo de parte e de
% capitulo, sumario, tabela densa, ficha, nota e apendice deitado.
%
% MANCHA. E a de manual do preambulo base: coluna unica de 152 mm, com
% os titulos recuados 14 mm para a esquerda. O documento em pe nao carrega
% `geometry`. Nao ha mais duas colunas.
%
% TABELA DEITADA. Tabela que nao cabe nem na largura util de 166 mm vai
% para `landscape`, que gira a pagina tambem no leitor de PDF. Documento
% que e so tabela larga -- `tarefas-dados.tex`, `modelos-metodos.tex` --
% carrega `geometry` proprio antes desta folha e corre inteiro deitado;
% ali a margem de titulo vale zero.
%
% PALETA. O destaque e o verde da marca Solara, #658637, a folha de cima
% do simbolo em `solara-logo-on-light.png`. A fechada nao vem da
% marca: nenhum verde dela e escuro o bastante, entao e o mesmo matiz e
% saturacao rebaixados ate a separacao de claridade que a paleta anterior
% usava. A tinta2 sai do quase-preto quente #24201B, clareado ate o
% contraste que a cinza anterior tinha.
%
% Sobre papel branco, destaque 4,18:1 e fechada 11,21:1; entre si, 2,68.
% Os papeis se distinguem por claridade, e nao por matiz.
%
% Sem dependencia de pacote externo a este diretorio: um relatorio que
% nao compila num clone limpo nao e um relatorio.
%
% DIRETORIO. Compile de dentro de `report/`: o caminho do preambulo base
% e o da marca sao relativos a ele.
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilo-reporte}[2026/09/01 Relatorio de andamento Solara]

\input{config/preambulo}

\RequirePackage{longtable}
\RequirePackage{tocloft}
% Enchimento da maquete. Sai quando o texto entrar; enquanto estiver
% carregado, o PDF mostra a forma do documento e nao o conteudo dele.
\RequirePackage{lipsum}

% --- cores -----------------------------------------------------------
\definecolor{destaque}{HTML}{658637}
\definecolor{fechada}{HTML}{30401A}
\definecolor{tinta2}{HTML}{595043}

% --- fios e tinta de tabela ------------------------------------------
\setlength{\heavyrulewidth}{0.6pt}
\setlength{\lightrulewidth}{0.4pt}
\setlength{\aboverulesep}{0.35ex}
\setlength{\belowrulesep}{0.45ex}

% --- titulos ---------------------------------------------------------
% Secao e subdivisoes saem do preambulo base. Parte e capitulo sao so do
% relatorio, que e `book`. Avancam sobre a margem de titulo, como a
% secao. O titulo nao e justificado nem hifenizado.

\titleformat{\part}[display]
  {\sffamily\bfseries\Huge\filright}
  {\normalsize\normalfont\sffamily\bfseries\color{destaque}PARTE \thepart}
  {0.6em}{}
\titleformat{\chapter}[display]
  {\sffamily\bfseries\LARGE}
  % `\chaptertitlename` vira Apêndice depois do `\appendix`, e o rótulo
  % acompanha sem intervenção.
  {\normalsize\normalfont\sffamily\color{tinta2}\chaptertitlename\ \thechapter}
  {0.4em}{\hyphenpenalty=10000\exhyphenpenalty=10000\hbadness=10000 }
\titlespacing*{\chapter}{-\margemmanual}{0pt}{1.4em}
\titlespacing*{\part}{-\margemmanual}{0pt}{1.4em}

% O sumario acompanha os titulos de parte e de capitulo.
\renewcommand{\cfttoctitlefont}{\sffamily\bfseries\Huge}
\renewcommand{\cftpartfont}{\sffamily\bfseries}
\renewcommand{\cftpartpagefont}{\sffamily\bfseries}
\renewcommand{\cftchapfont}{\sffamily\bfseries}
\renewcommand{\cftchappagefont}{\sffamily\bfseries}
\renewcommand{\cftsecfont}{\sffamily}
\renewcommand{\cftsecpagefont}{\sffamily}
\renewcommand{\cftsubsecfont}{\sffamily}
\renewcommand{\cftsubsecpagefont}{\sffamily}
\renewcommand{\cftchapleader}{\cftdotfill{\cftdotsep}}
\setlength{\cftbeforechapskip}{.35em}
\setlength{\cftsecnumwidth}{2.9em}

% --- abertura -------------------------------------------------------
% A abertura de um documento avulso da linha: marca a esquerda, titulo e
% linha de contexto a direita, e um fio da cor de destaque fechando.
%
% Fica aqui, e nao no corpo de cada `.tex`, porque e o que faz destes
% arquivos um modelo e nao quatro aberturas parecidas. Um documento novo
% preenche os tres campos e nao decide mais nada de forma.
%
% A marca e logotipo horizontal, 634 x 90 px, de proporcao 7:1: simbolo
% de duas folhas e a palavra Solara em tinta escura, a versao para fundo
% claro. Os 30 mm de `\marcalargura` dao 4,3 mm de altura, perto da altura
% de uma linha do titulo. Nao encolha sem olhar impresso.
%
%   \marca{outro/arquivo.png}         % sem isso, a marca do preambulo base
%   \autoria{Nome}{correio@dominio}    % opcional; sem isso a linha some
%   \abertura{Titulo}{Registro de ... \textbackslash{} data \textbackslash{} arquivo}
%
% UMA FORMA SO. `\abertura` e `\aberturaunica` imprimem o mesmo bloco.
% Os dois nomes ficam porque os documentos ja os usam; a diferenca entre
% eles era o `\twocolumn`, que saiu com a forma de manual. O bloco ocupa
% a largura util inteira, margem de titulo incluida.
%
% O corpo do bloco fica em `\re@aberturacorpo` para que as duas versoes
% nao se separem: mexer na marca, no fio ou na assinatura de uma mexe na
% outra.
\newlength{\marcalargura}\setlength{\marcalargura}{30mm}
\newlength{\marcarespiro}\setlength{\marcarespiro}{5mm}

\newcommand{\re@marca}{\marcaarquivo}
\newcommand{\marca}[1]{\renewcommand{\re@marca}{#1}}

\newcommand{\re@autor}{}
\newcommand{\re@correio}{}
\newcommand{\autoria}[2]{\renewcommand{\re@autor}{#1}\renewcommand{\re@correio}{#2}}

% O correio vira `mailto:`. `hyperref` entra com `hidelinks`, entao ele
% clica sem pintar de azul nem emoldurar, e o PDF impresso nao muda.
\newcommand{\re@assinatura}{%
  \ifx\re@autor\@empty\else
    {\sffamily\fontsize{8.4}{10.4}\selectfont\color{tinta2}%
     \re@autor
     \ifx\re@correio\@empty\else
       \ \textperiodcentered\ \href{mailto:\re@correio}{\texttt{\re@correio}}%
     \fi\par}%
  \fi}

% A largura da mancha entra como argumento, e nao como `\textwidth` lido
% de dentro, porque `lscape` NAO mexe em `\textwidth`: ele troca `\hsize`,
% `\linewidth` e `\columnwidth`, e `\textwidth` continua valendo a largura
% da pagina em pe. Um fio de `\textwidth` dentro de `landscape` para a dois
% tercos da mancha -- fica curto, e parece descuido de desenho.
\newcommand{\re@aberturacorpo}[2]{%
  \gdef\doctitulo{#1}%
  \thispagestyle{rosto}%
  \begin{adjustwidth}{-\margemmanual}{0pt}%
  \vspace*{-0.4em}%
  \noindent
  % A marca alinha pelo pe do bloco de texto, e nao pelo topo: o titulo
  % pode ocupar uma ou duas linhas e o conjunto nao balanca.
  \begin{minipage}[b]{\marcalargura}%
    \includegraphics[width=\marcalargura]{\re@marca}%
  \end{minipage}%
  \hspace{\marcarespiro}%
  \begin{minipage}[b]{\dimexpr\linewidth-\marcalargura-\marcarespiro\relax}%
    {\sffamily\bfseries\LARGE\hyphenpenalty=10000\exhyphenpenalty=10000
     \raggedright #1\par}%
    \vspace{0.35em}%
    {\sffamily\fontsize{9}{11}\selectfont\color{tinta2}\raggedright #2\par}%
    \vspace{0.25em}%
    \re@assinatura
  \end{minipage}%
  \vspace{0.7em}\par
  \noindent{\color{destaque}\rule{\linewidth}{0.6pt}}%
  \end{adjustwidth}%
  \vspace{1.0em}%
}

% A pagina da abertura sai sem cabecalho, porque o titulo ja esta no
% bloco, e com o rodape de identificacao.
\newcommand{\abertura}[2]{\re@aberturacorpo{#1}{#2}\par}
\newcommand{\aberturaunica}[2]{\re@aberturacorpo{#1}{#2}\par}

% --- marcacoes de texto ----------------------------------------------
% Nome do experimento, em versalete. A Charis SIL traz versalete proprio,
% e o preambulo base ja o espaceja; o negrito fica reservado a enfase.
\newcommand{\exper}[1]{\textsc{#1}}
\newcommand{\termo}[1]{\textbf{\textcolor{destaque}{#1}}}
\newcommand{\campo}[1]{\par\smallskip\noindent\textbf{\textcolor{destaque}{#1.}}\space}

% O corpo 7,4 da tabela e o 6,8 da nota fazem o LaTeX pedir matematica
% a 3,7 pt, que a familia nao tem. As duas linhas abaixo fixam o piso em
% 5 pt e deixam o log limpo.
\DeclareMathSizes{7.4}{7.4}{6}{5}
\DeclareMathSizes{6.8}{6.8}{6}{5}
\newcommand{\tabfont}{\sffamily\fontsize{7.4}{9}\selectfont}
\newcommand{\tabfontw}{\sffamily\fontsize{8}{10}\selectfont}
% Coluna a esquerda que NAO desliga o diagnostico de caixa larga: com
% `\rightskip` em `plus 1fil` o TeX nunca acusa Overfull, e conteudo
% inquebravel vaza sobre a coluna vizinha em silencio.
\newcommand{\rag}{\raggedright\rightskip=0pt plus 2em\relax\hbadness=10000 }
\newcommand{\cab}[1]{\textbf{#1}}
% Texto no fluxo vertical, e nao `minipage`. A nota estava numa `minipage`
% posta em modo horizontal: a caixa ancorava pela linha de base, e o que
% passasse dela descia sobre o que viesse depois. `[t]` nao resolve, porque
% o bloco seguinte destes documentos e uma `promancha`, e `multicols` zera
% `\prevdepth` -- a cola entre linhas some e a coluna comeca na ultima linha
% de base da nota. Medido em `tarefas-dados.tex`: com nota de quatro linhas,
% o paragrafo seguinte imprimia por cima de duas delas.
% Estreitar `\hsize` da a mesma medida de 96% sem caixa nenhuma, e as linhas
% da nota entram na lista vertical como qualquer paragrafo.
\newcommand{\notas}[1]{%
  \par\vspace{0.4em}%
  \begingroup
    \advance\hsize by -0.04\hsize
    \linewidth=\hsize
    \parindent=0pt
    \sffamily\fontsize{6.8}{8.6}\selectfont\color{tinta2}%
    \noindent #1\par
  \endgroup
  \vspace{0.3em}}

\newlist{ficha}{description}{1}
\setlist[ficha]{font=\normalfont\sffamily\fontsize{7.4}{9}\selectfont\bfseries,
  leftmargin=1.9cm, labelwidth=1.6cm, labelsep=0.3cm, itemsep=0.1em,
  topsep=0.45em, before=\sffamily\fontsize{7.4}{9}\selectfont}

% Conclusao copiada do registro do experimento, nunca reescrita.
\newcommand{\conclusao}[1]{%
  \par\vspace{0.3em}\noindent
  \begin{tabular}{@{}p{0.4em}@{\hspace{0.7em}}p{\dimexpr\linewidth-2.1em}@{}}
  \textcolor{destaque}{\rule{0.35em}{1.6em}} &
  \footnotesize\itshape #1\end{tabular}\par\vspace{0.5em}}

% Objecao: o que limita ou contradiz o que se acabou de afirmar.
\newenvironment{objecao}
  {\par\smallskip\noindent\begin{tabular}{@{}p{0.4em}@{\hspace{0.7em}}p{\dimexpr\linewidth-2.1em}@{}}
   \textcolor{fechada}{\rule{0.35em}{1.6em}} & \footnotesize}
  {\end{tabular}\par\smallskip}

% --- marca de vaga ----------------------------------------------------
% O esqueleto compila e imprime o que falta. Ao preencher, o comando
% sai inteiro. Uma varredura por `\pe` diz quanto do relatorio existe.
\newcommand{\pe}[2][]{%
  {\sffamily\fontsize{8}{10}\selectfont\color{tinta2}%
   $\langle$\,\ifx\relax#1\relax\else\textbf{#1}: \fi #2\,$\rangle$}}
\newcommand{\pepar}[2][]{\par\noindent\pe[#1]{#2}\par}

% --- apendice deitado -------------------------------------------------
% Prosa dentro do apendice deitado. A mancha tem 25,3 cm, que numa coluna
% so dariam 145 caracteres por linha -- ilegivel.
%
% A versao anterior resolvia isso fixando o bloco em 15 cm, o que acerta a
% medida de linha e erra o resto: sobravam 10 cm de branco a direita de
% toda prosa, e a altura do bloco ficava 1,7 vez maior do que precisava.
% Num documento que alterna prosa e tabela larga isso se acumula --- a
% prosa que segue cada tabela nao cabia na pagina dela e caia sozinha na
% seguinte, e o `\clearpage` da secao seguinte congelava a pagina de cauda
% com cinco linhas de texto. Eram tres paginas assim.
%
% Duas colunas resolvem os dois de uma vez: 12,05 cm de coluna dao ~70
% caracteres por linha, dentro da faixa de 45 a 60 a 75 que o cabecalho
% desta folha discute, e a altura cai pela metade.
%
% Medido nos dois documentos que usam o ambiente: `tarefas-dados.tex` cai de
% 9 para 6 paginas e `reporte.tex` de 38 para 37.
%
% BLOCO CURTO fica 2+1: `multicols` balanceia por altura, e tres linhas nao
% dividem bem. Chegou a existir aqui uma opcao `[1]` que devolvia a mancha
% de 15 cm para esses casos, e ela foi retirada depois de medida: as duas
% `promancha` curtas de `modelos-metodos.tex` ganham uma linha cada em 15 cm,
% a linha empurra a tabela e o documento vai de 2 para 3 paginas. Uma linha
% solta na segunda coluna custa menos que uma pagina.
%
% OS COMPRIMENTOS FICAM DENTRO DO AMBIENTE, e nao no preambulo desta folha.
% `\columnsep` e o mesmo registro que o `twocolumn` do documento em pe usa,
% e o `geometry` de `modelo.tex` ja o fixa em 0,7 cm; setado fora, ele
% vazava para os documentos de duas colunas e repaginava os `execucao-*` --
% `execucao-cmo` foi de 2 para 3 paginas so por isso. O grupo do ambiente
% devolve o valor no `\end`.
%
% O ambiente NAO pode depender de `\if@twocolumn` para decidir nada: essa
% chave e a opcao da classe, fixa no preambulo, e o `reporte.tex` e
% `twocolumn` na classe mas entra nos apendices deitados via `\onecolumn`.
% Testado: condicionar a definicao a ela derruba a compilacao do relatorio.
\RequirePackage{multicol}
\newenvironment{promancha}
  {\par
     \setlength{\columnsep}{1.2cm}%
     % `multicols` empurra o bloco inteiro para a pagina seguinte quando
     % sobra menos que `\premulticols` -- 50 pt de fabrica, quase duas
     % linhas. Num documento deitado que alterna tabela e prosa e isso que
     % fabrica pagina de cauda: sobra meia pagina e o bloco pula assim
     % mesmo. Zerados, a prosa quebra onde a pagina acaba.
     \setlength{\premulticols}{0pt}%
     \setlength{\postmulticols}{0pt}%
     \setlength{\multicolsep}{0pt}%
     \begin{multicols}{2}}
  {\end{multicols}\par\medskip}

\setlength{\emergencystretch}{4em}
\endinput
