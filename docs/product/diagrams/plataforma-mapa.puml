' Solara: especificação da aplicação
' Diagramas da especificação (plataforma-mapa.tex)
'
' Renderizar, de dentro de docs/product/diagrams/:
'   plantuml -charset UTF-8 -tsvg -tpng plataforma-mapa.puml
'   rsvg-convert -f pdf -o arquitetura-solara.pdf arquitetura-solara.svg
'   rsvg-convert -f pdf -o fluxo-leitura.pdf fluxo-leitura.svg
'
' Estilo: caixa de borda preta e fundo branco, grupo em #F3F3F3, sem sombra,
' ligação por tipo com cor e traço redundantes, leiaute ortogonal.

' ===========================================================================
' 1. Arquitetura: o que roda na máquina e o que cada parte lê
' ===========================================================================
@startuml arquitetura-solara
left to right direction
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 0
skinparam linetype ortho
skinparam nodesep 28
skinparam ranksep 70
skinparam packageStyle rectangle
skinparam ArrowColor #000000
skinparam package {
  BackgroundColor #F3F3F3
  BorderColor #000000
  FontStyle bold
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #000000
  Style rectangle
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam file {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #000000
}

package "Carga do store (fora do Solara)" as carga {
  component "Carregador do TERRA\nONS e ANEEL -> esquema br" as l_terra
  component "Carregador da BDGD\n-> esquema bdgd\n(não distribuído)" as l_bdgd
  component "contract/load.py\nWRI, OSM, geoBoundaries\n-> esquema solara" as l_contrato
}

package "Máquina do usuário" as maq {
  database "Grid store\nPostgreSQL + PostGIS\n(só leitura)" as store
  component "Sidecar Python\num processo por pedido\nenergy, sun, terrain,\ngrid, weather, world" as sidecar
  component "Casca Go/Wails\nbindings, um pedido por vez,\ncancelável" as casca
  component "Interface (webview)\nestúdio: mapa, editores,\noperadores, desfazer" as ui
  file "Projeto\nnome.solara\nnome.solara-data" as projeto
  file "Cache do usuário\nséries POWER,\ncampo de vento da hora" as cache
}

package "Fontes públicas, lidas sob demanda" as pub {
  component "NASA POWER\nirradiação, meteorologia" as power
  component "Planetary Computer\nCopernicus DEM GLO-30,\nESA WorldCover 2021" as pc
  component "NOAA GFS (UCAR THREDDS)\ncampo de vento" as gfs
  component "geoBoundaries\nlimites de qualquer país" as geob
  component "IBGE\nmalhas e localidades" as ibge
  component "NASA GIBS, RainViewer,\nOpen-Meteo\nnuvens, chuva, condições agora" as tempo
  component "OpenFreeMap, EOX Sentinel-2,\nSIGEL, Black Marble\nfundos e registros publicados" as fundos
}

' chamada local: contínua preta
ui --> casca
casca --> sidecar
sidecar --> store
casca --> projeto
sidecar --> cache

' leitura pela rede: tracejada azul
sidecar -[#0072B2,dashed]-> power
sidecar -[#0072B2,dashed]-> pc
sidecar -[#0072B2,dashed]-> gfs
sidecar -[#0072B2,dashed]-> geob
ui -[#0072B2,dashed]-> ibge
ui -[#0072B2,dashed]-> tempo
ui -[#0072B2,dashed]-> fundos

' carga feita por outro programa: pontilhada cinza
l_terra -[#777777,dotted]-> store
l_bdgd -[#777777,dotted]-> store
l_contrato -[#777777,dotted]-> store

legend bottom left
  contínua preta: chamada local
  tracejada azul: leitura pela rede
  pontilhada cinza: carga feita por outro programa
end legend
@enduml

' ===========================================================================
' 2. Fluxo de uma leitura: do lugar escolhido no mapa à camada no mapa
' ===========================================================================
@startuml fluxo-leitura
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 0
skinparam ArrowColor #000000
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #000000
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #000000
}
skinparam partition {
  BackgroundColor #F3F3F3
  BorderColor #000000
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #777777
}

start
partition "Mapa" {
  :Escolher o lugar;
  note right
    sítio: um ponto
    área: uma entrada do catálogo de limites
  end note
}
partition "Propriedades" {
  :Abrir o cartão do produto;
  if (O produto responde aqui?) then (não)
    :O cartão diz o motivo\n(store ausente, sem rede,\nsem o registro brasileiro);
    stop
  else (sim)
  endif
  :Ler a lista de entradas e o estado de cada uma;
  :Executar;
}
partition "Sidecar" {
  :Validar o lugar antes de baixar;
  :Calcular, com progresso e cancelamento;
  if (Alguma entrada não pôde ser lida?) then (sim)
    :A execução falha e a entrada fica em erro;
    stop
  else (não)
  endif
}
partition "Projeto" {
  :Gravar o resultado com os parâmetros e o lugar;
}
partition "Mapa e leitura" {
  :Desenhar a camada e enquadrar o lugar;
  :Abrir a leitura: um número, até quatro\nnúmeros de apoio, painéis, método;
  :Comparar com outros resultados do produto\ne exportar (CSV, JSON, GeoTIFF);
}
if (O lugar ou um parâmetro mudou depois?) then (sim)
  :O resultado é marcado obsoleto;
else (não)
endif
stop
@enduml
