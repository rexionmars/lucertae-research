' Plataforma preditiva baseada em mapa
' Diagramas da especificação (plataforma-mapa.tex)
'
' Renderizar: plantuml -charset UTF-8 -tsvg -tpng plataforma-mapa.puml

' ===========================================================================
' 1. Hierarquia de camadas: o que o usuário pode selecionar
' ===========================================================================
@startuml hierarquia-camadas
title Hierarquia de camadas — o "onde" é sempre uma entidade

skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #444444
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #F4F8FC
  BorderColor #1C568C
  HeaderBackgroundColor #EAF1F8
}
skinparam class<<agregada>> {
  BackgroundColor #FFF8E6
  BorderColor #B07A1A
}
skinparam class<<recorte>> {
  BackgroundColor #FFFFFF
  BorderColor #8AA9C7
}
hide circle
hide methods
hide empty members

package "Hierarquia elétrica (onde vivem os dados e os modelos)" {
  class "Operador / área de concessão" as op {
    perda agregada
    carga e MMGD previstas
    insights consolidados
  }
  class "Subestação" as se {
    carregamento previsto
    risco de ativos
  }
  class "Alimentador" as al {
    perda estimada
    carregamento previsto
    MMGD prevista
  }
  class "Transformador" as tr {
    perda estimada
    balanço energético
    carregamento previsto
  }
  class "Unidades consumidoras" as uc <<agregada>> {
    exibidas agregadas por padrão, LGPD
    nível individual só como alvo de plano
  }
  class "Ativo / equipamento" as at {
    risco de falha
    idade, histórico de ocorrências
  }
}

package "Recortes administrativos (cruzamento, não modelagem)" {
  class "Estado" as uf <<recorte>>
  class "Município" as mun <<recorte>>
  class "Setor censitário" as set <<recorte>>
  class "Submercado" as sub <<recorte>>
}

op "1" *-- "n" se
se "1" *-- "n" al
al "1" *-- "n" tr
tr "1" *-- "n" uc
se "1" o-- "n" at
al "1" o-- "n" at

uf "1" *-- "n" mun
mun "1" *-- "n" set

mun ..> al : recorta
sub ..> op : agrega

legend right
  Toda entidade selecionável tem dado e modelo por trás.
  Os níveis são os mesmos usados pela engine
  para consolidar insights (filho → pai).
end legend
@enduml

' ===========================================================================
' 2. Arquitetura: das fontes ao mapa e ao feed de insights
' ===========================================================================
@startuml arquitetura-mapa
title Plataforma preditiva baseada em mapa — arquitetura

left to right direction
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam ArrowColor #444444
skinparam component {
  BackgroundColor #F4F8FC
  BorderColor #1C568C
}
skinparam database {
  BackgroundColor #EAF1F8
  BorderColor #1C568C
}

package "Fontes públicas (nível 0)" as pub {
  component "BDGD / ANEEL\n(rede georreferenciada,\nconsumo mensal)" as bdgd
  component "ONS, ANEEL, IBGE\n(carga, MMGD,\nsetores censitários)" as publicos
  component "Previsão do tempo\ne satélite" as nwp
}

package "Cliente" as cli {
  component "Arquivos mensais\n(faturamento, cadastro,\ninspeções) — nível 1" as arquivos
  component "Conector agendado\n— nível 2" as conector <<V2>>
  component "Medição de trafos / AMI\n— nível 3" as medicao <<V3>>
}

package "Ingestão" as ing {
  component "Mapeamento para o\nmodelo canônico" as mapeamento
  component "Validação e\nqualidade" as validacao
}

package "Modelo canônico" as mc {
  database "Entidades\n(geometria + hierarquia)" as entidades
  database "Séries bitemporais\n(referência × conhecido em)" as series
  database "Eventos e rótulos" as rotulos
}

package "Modelos" as mod {
  component "Perdas" as m_perdas
  component "Carga e MMGD" as m_carga
  component "Risco de ativos" as m_risco <<V3>>
}

database "Store de camadas\n(entidade × data × versão\n× quantis P10/P50/P90)" as camadas

package "Engine de análise" as eng {
  component "Detectores" as detectores
  component "Pontuação e\nconsolidação" as pontuacao
  component "Narrativa\n(texto a partir\nde números)" as narrativa
  database "Insights" as insights
}

component "Planejador\n(alvos e rotas\nsob restrição)" as planejador

package "Interface" as ui {
  component "Mapa\n(camadas, trilha, filtro)" as mapa
  component "Feed de insights" as feed
  component "Painel da entidade" as painel
  component "App de campo" as appcampo
}

actor "Usuário de negócio" as usuario
actor "Equipe de campo" as campo

bdgd --> mapeamento
publicos --> mapeamento
nwp --> mapeamento
arquivos --> mapeamento
conector ..> mapeamento
medicao ..> mapeamento
mapeamento --> validacao
validacao --> entidades
validacao --> series
validacao --> rotulos

entidades --> m_perdas
series --> m_perdas
rotulos --> m_perdas
series --> m_carga
rotulos ..> m_risco

m_perdas --> camadas
m_carga --> camadas
m_risco ..> camadas

camadas --> detectores
detectores --> pontuacao
pontuacao --> narrativa
narrativa --> insights

camadas --> mapa
camadas --> planejador
insights --> feed
insights --> painel
planejador --> mapa
planejador --> appcampo

mapa --> usuario
feed --> usuario
painel --> usuario
appcampo --> campo

feed ..> rotulos : avaliação (útil / falso)
appcampo ..> rotulos : resultado da inspeção

legend right
  <<V2>>, <<V3>>: roadmap
  Toda camada e todo insight guardam
  entidade, data de referência e versão do modelo
  Tracejado: retorno que vira rótulo de treino
end legend
@enduml

' ===========================================================================
' 3. Engine de análise: das camadas ao feed
' ===========================================================================
@startuml engine-insights
title Engine de análise — pipeline de um ciclo

skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #444444
skinparam activity {
  BackgroundColor #F4F8FC
  BorderColor #1C568C
  DiamondBackgroundColor #FFF8E6
  DiamondBorderColor #B07A1A
}
skinparam NoteBackgroundColor #FFF8E6
skinparam NoteBorderColor #B07A1A

start
:Novo ciclo de camadas publicado
(ou pergunta sobre uma seleção);

fork
  :Anomalia espacial
  (entidade × vizinhas);
fork again
  :Tendência e limiar
  (trajetória prevista);
fork again
  :Mudança entre ciclos;
fork again
  :Concentração
  (aglomerados);
fork again
  :Divergência
  modelo × registro;
fork again
  :Desempenho do
  próprio modelo;
end fork

:Candidatos a insight
(entidade, métrica, comparação, incerteza);

if (Significativo acima da incerteza?) then (não)
  :Descarta;
  stop
else (sim)
endif

:Pontuação =
magnitude × confiança × valor (R$ / MWh);

:Consolidação hierárquica
(filhos semelhantes viram um insight no pai);

:Explicação
(variáveis que mais pesaram);

:Ação sugerida
(plano, inspeção, estudo);

:Narrativa
(texto gerado a partir dos números da engine);
note right
  Números, rankings e comparações
  vêm só da engine. Se houver LLM,
  ele só redige.
end note

:Publica no feed, ranqueado,
com link para a entidade no mapa;
stop
@enduml

' ===========================================================================
' 4. Ciclo de vida de um insight
' ===========================================================================
@startuml ciclo-insight
title Ciclo de vida de um insight

skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 60
skinparam roundcorner 12
skinparam ArrowColor #333333
skinparam state {
  BackgroundColor #FFE066
  BorderColor #333333
  StartColor #111111
  EndColor #111111
}
hide empty description

state "Detectado" as Detectado
state "Consolidado\nno pai" as Consolidado
state "Publicado" as Publicado
state "Visto" as Visto
state "Em ação" as Acao
state "Resolvido" as Resolvido
state "Descartado" as Descartado
state "Expirado" as Expirado

[*] --> Detectado
Detectado --> Consolidado : Semelhante a\nirmãos na hierarquia
Detectado --> Publicado : Pontuação acima\ndo corte
Consolidado --> [*]
Publicado --> Publicado : Novo ciclo\natualiza magnitude
Publicado --> Visto : Usuário abre
Publicado --> Expirado : Condição some\nno ciclo seguinte
Visto --> Acao : Gera plano\nou aceita ação
Visto --> Descartado : Marcado como\nfalso ou irrelevante
Acao --> Resolvido : Resultado\nregistrado
Resolvido --> [*] : Vira rótulo
Descartado --> [*] : Vira rótulo
Expirado --> [*]
@enduml

' ===========================================================================
' 5. Casos de uso centrados nos gestos
' ===========================================================================
@startuml casos-de-uso-mapa
title Plataforma preditiva baseada em mapa — casos de uso

left to right direction
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowColor #444444
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F4F8FC
  BorderColor #1C568C
  BackgroundColor<<V2>> #FFFFFF
  BorderColor<<V2>> #8AA9C7
}
skinparam rectangle {
  BorderColor #1C568C
}

actor "Usuário de negócio" as usuario
actor "Gerente de recuperação\nde energia" as gerente
actor "Engenheiro de\nplanejamento" as planejador
actor "Equipe de campo" as campo
actor "Cientista de dados" as cientista

usuario <|-- gerente
usuario <|-- planejador

rectangle "Plataforma" {
  package "Onde (seleção por camadas)" {
    usecase "Navegar na hierarquia\nde camadas" as UC_nav
    usecase "Buscar entidade\npor nome ou código" as UC_busca
    usecase "Filtrar entidades\npor atributo" as UC_filtro
    usecase "Selecionar\nvárias entidades" as UC_multi
  }
  package "O quê e quando" {
    usecase "Escolher camada\nde modelo" as UC_camada
    usecase "Controlar tempo\n(histórico, agora, horizonte)" as UC_tempo
  }
  package "Saídas" {
    usecase "Ver feed de insights" as UC_feed
    usecase "Abrir insight no mapa" as UC_abrir
    usecase "Ver diagnóstico\nda entidade" as UC_diag
    usecase "Gerar plano de ação" as UC_plano
    usecase "Informar restrição\n(orçamento, equipes)" as UC_restr
    usecase "Exportar relatório" as UC_rel
    usecase "Perguntar em\ntexto livre" as UC_perg <<V2>>
    usecase "Simular cenário" as UC_sim <<V2>>
  }
  package "Aprendizado" {
    usecase "Registrar resultado\nde inspeção" as UC_result
    usecase "Avaliar insight\n(útil / falso)" as UC_aval
    usecase "Calibrar detectores\ne monitorar modelos" as UC_calib
  }
}

usuario --> UC_nav
usuario --> UC_busca
usuario --> UC_filtro
usuario --> UC_camada
usuario --> UC_tempo
usuario --> UC_feed
usuario --> UC_diag
usuario --> UC_aval
usuario --> UC_perg
usuario --> UC_sim
gerente --> UC_plano
planejador --> UC_rel
campo --> UC_result
cientista --> UC_calib

UC_multi .> UC_filtro : <<extend>>
UC_abrir .> UC_feed : <<extend>>
UC_abrir ..> UC_diag : <<include>>
UC_plano ..> UC_restr : <<include>>
UC_rel ..> UC_diag : <<include>>

legend right
  Casos <<V2>>: roadmap
  O "onde" nunca é desenhado à mão:
  vem da hierarquia, da busca ou do filtro.
  Ingestão e ciclo de modelos: ver arquitetura
end legend
@enduml

' ===========================================================================
' 6. Sessão típica: do feed ao plano e ao resultado
' ===========================================================================
@startuml sessao-usuario
title Sessão típica — gerente de recuperação de energia

skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam roundcorner 8
skinparam sequenceMessageAlign left
skinparam ParticipantBorderColor #1C568C
skinparam ParticipantBackgroundColor #F4F8FC
skinparam DatabaseBorderColor #1C568C
skinparam DatabaseBackgroundColor #EAF1F8
skinparam NoteBackgroundColor #FFF8E6

actor "Gerente" as ger
participant "Mapa" as mapa
participant "Feed" as feed
participant "Painel da\nentidade" as painel
participant "Planejador" as plan
database "Camadas e\ninsights" as db
actor "Equipe de\ncampo" as campo

== Abrir a plataforma (nenhum input) ==
ger -> mapa : abre
mapa -> db : camadas da área de concessão
feed -> db : insights publicados, ranqueados
feed --> ger : "AL-04: perda subiu de 7% para 18% em 3 meses"

== Seguir o insight ==
ger -> feed : clica no insight
feed -> mapa : foco em AL-04, liga camada de perda
mapa --> ger : transformadores coloridos por perda (P50)
feed -> painel : abre AL-04
painel --> ger : comparação, tendência, variáveis que pesaram

== Descer na hierarquia ==
ger -> mapa : clica no transformador T-1183
mapa -> painel : abre T-1183 (trilha: Concessão › SE Centro › AL-04 › T-1183)
painel --> ger : balanço negativo, 40 unidades com queda de consumo

== Pedir a decisão ==
ger -> painel : "Gerar plano de inspeção"
painel -> ger : pede restrição
ger -> painel : 50 inspeções, 2 equipes, próxima semana
painel -> plan : seleção + restrição
plan -> db : probabilidades e energia estimada por alvo
plan --> mapa : 50 alvos e 2 rotas
mapa --> ger : energia recuperável estimada (faixa)
ger -> plan : aprova
plan -> campo : ordens de serviço no app de campo

== Fechar o ciclo ==
campo -> db : resultado de cada inspeção
note right of db
  Cada resultado vira rótulo
  para o próximo ciclo de treino,
  e o insight passa a "Resolvido"
end note
@enduml
